{
  "name": "lottie-render",
  "version": "1.1.0",
  "description": "Render Lottie animations to MP4 video, frame by frame, using Playwright and FFmpeg \u2014 usable as a library or as a self-hosted HTTP service",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "templates",
    "public",
    "docs",
    "README.zh-CN.md",
    "assets/demo.gif",
    "assets/demo-animation.json",
    "DOCKER.md"
  ],
  "license": "MIT",
  "author": "Steven Pan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/steven-panxd/lottie-render.git"
  },
  "bugs": {
    "url": "https://github.com/steven-panxd/lottie-render/issues"
  },
  "homepage": "https://lottie.xuedo.ng/",
  "scripts": {
    "dev": "tsx watch src/server/start.ts",
    "build": "tsc",
    "demo": "npm run build && node examples/render-demo.cjs",
    "benchmark": "npm run build && node scripts/benchmark.cjs",
    "start": "node dist/server/start.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:render": "tsx src/test-render.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "postinstall": "playwright install chromium",
    "serve:demo": "npm run build && node dist/cli.js serve --preset demo",
    "prepack": "npm run build"
  },
  "keywords": [
    "lottie",
    "animation",
    "video",
    "render",
    "playwright",
    "ffmpeg",
    "mp4"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "playwright": "^1.40.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/multer": "^2.0.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "typescript": "^5.3.3",
    "tsx": "^4.7.0",
    "vitest": "^2.1.8"
  },
  "bin": {
    "lottie-render": "dist/cli.js"
  },
  "optionalDependencies": {
    "express": "^4.18.2",
    "multer": "^2.0.2",
    "dotenv": "^16.3.1"
  }
}
