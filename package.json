{
  "name": "lottie-render",
  "version": "1.0.0",
  "description": "Render Lottie animations to MP4 video, frame by frame, using Playwright and FFmpeg — usable as a library or as a self-hosted HTTP service",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "templates"
  ],
  "license": "MIT",
  "author": "Steven Pan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/steven-panxd/lottie-render.git"
  },
  "bugs": {
    "url": "https://github.com/steven-panxd/lottie-render/issues"
  },
  "homepage": "https://github.com/steven-panxd/lottie-render#readme",
  "scripts": {
    "dev": "tsx watch src/server/start.ts",
    "build": "tsc",
    "start": "node dist/server/start.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:render": "tsx src/test-render.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "postinstall": "playwright install chromium"
  },
  "keywords": [
    "lottie",
    "animation",
    "video",
    "render",
    "playwright",
    "ffmpeg",
    "mp4"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "express": "^4.18.2",
    "playwright": "^1.40.1",
    "multer": "^1.4.5-lts.1",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/multer": "^1.4.11",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "typescript": "^5.3.3",
    "tsx": "^4.7.0",
    "vitest": "^2.1.8"
  }
}
