# ==============================================================================
# lottie-render — server mode environment configuration
# ==============================================================================
# Only used when running the optional HTTP service (src/server/). Copy this
# file to .env and configure your settings.
# For Docker: docker-compose will read .env automatically

# Server Configuration
PORT=3000
NODE_ENV=production

# API Authentication
# IMPORTANT: Required when NODE_ENV=production — the server refuses to start
# without it. Set a strong, random value.
API_KEY=your-secret-api-key-here

# Concurrency Control
# Maximum number of concurrent render tasks (default: 5)
# Adjust based on your server resources
MAX_CONCURRENT_RENDERS=5

# Resource caps (see the README's Security section)
# MAX_FRAMES=6000
# MAX_DIMENSION=4096

# Explicit public demo with built-in limits and upload UI:
# RENDER_PRESET=demo
# MAX_UPLOAD_BYTES=2097152
# MAX_DURATION_SECONDS=10
# RENDER_TIMEOUT_MS=60000
# REQUESTS_PER_MINUTE=5
# TRUST_PROXY_HOPS=1  # Only behind exactly one trusted proxy
