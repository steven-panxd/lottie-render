# ==============================================================================
# Lottie Render Service - Environment Configuration
# ==============================================================================
# Copy this file to .env and configure your settings
# For Docker: docker-compose will read .env automatically

# Server Configuration
PORT=3000
NODE_ENV=production

# API Authentication
# IMPORTANT: Set a strong API key for production
API_KEY=your-secret-api-key-here

# Concurrency Control
# Maximum number of concurrent render tasks (default: 5)
# Adjust based on your server resources
MAX_CONCURRENT_RENDERS=5

# Rendering Configuration (optional, uses JSON metadata by default)
# DEFAULT_WIDTH=1920
# DEFAULT_HEIGHT=1080
# DEFAULT_FPS=30
# JPEG_QUALITY=80
